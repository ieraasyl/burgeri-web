# Generate a strong value for local development and keep the real secret in
# .dev.vars or your deployment platform's secret store.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional Google Apps Script email OTP delivery
GAS_URL=
GAS_SECRET=

# Required only by Drizzle Studio / remote schema commands
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
DRIZZLE_API_TOKEN=
