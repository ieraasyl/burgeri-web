# Copy to `.env` for Node CLI tools (seed script, remote Drizzle Studio).
# Not loaded by `pnpm dev` — use `.dev.vars` for the Worker runtime.

# Optional override for seeded staff passwords in `pnpm db:seed:*`
SEED_STAFF_PASSWORD=Burgeri123!

# Must match `database_name` in wrangler.jsonc when seeding D1
D1_DATABASE_NAME=bahandi-db

# Required only for `pnpm db:studio:remote` (drizzle.config.ts)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
DRIZZLE_API_TOKEN=
