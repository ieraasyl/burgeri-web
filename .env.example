# Generate a strong value for local development and keep the real secret in
# .dev.vars or your deployment platform's secret store.
BETTER_AUTH_SECRET=1
BETTER_AUTH_URL=http://localhost:3000

# Optional Google Apps Script mobile photo uploads
GAS_URL=
GAS_SECRET=
# In the Apps Script project, set GAS_PHOTO_FOLDER_ID as a Script Property to
# choose the Drive folder for uploaded write-off photos.

# iikoCloud Inventory API. Configure these to post approved write-offs.
IIKO_API_LOGIN=
IIKO_API_BASE_URL=https://api-ru.iiko.services
IIKO_ORGANIZATION_ID=
IIKO_EXPENSE_ACCOUNT_ID=
# JSON maps from Burgeri database IDs to iiko GUIDs.
IIKO_STORAGE_MAP={"pos-abai":"00000000-0000-0000-0000-000000000000"}
IIKO_PRODUCT_MAP={"prod-tomato":"00000000-0000-0000-0000-000000000000"}
IIKO_TIMEOUT_MS=15000

# Optional override for pnpm db:seed:* staff demo credentials
SEED_STAFF_PASSWORD=Burgeri123!

# Required only by Drizzle Studio / remote schema commands
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_DATABASE_ID=
DRIZZLE_API_TOKEN=
